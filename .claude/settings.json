{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(./.env)",
      "Edit(./.env.longshot)",
      "Read(./keys/**)",
      "Edit(./keys/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/scripts/hooks/guard_live_orders.py\""
          }
        ]
      }
    ]
  }
}
