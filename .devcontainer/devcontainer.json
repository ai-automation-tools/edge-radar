{
  "name": "Edge-Radar",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "CONTRIBUTING.md"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "make install",
  "postCreateCommand": "pre-commit install && ([ -f .env ] || cp .env.example .env)"
}
