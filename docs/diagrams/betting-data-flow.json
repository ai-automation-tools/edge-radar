  "cards": [
    {
      "title": "How edge becomes a bet",
      "dot": "emerald",
      "items": [
        "Scan keeps opportunities with gross edge >= MIN_EDGE, max 2 per game",
        "The fee (rate x P x (1-P)) is added only at the risk gate and in sizing",
        "Kelly = KELLY_FRACTION / batch size x trusted net edge, capped by MAX_BET_SIZE and exposure",
        "Futures and prediction scanners feed the same execute_pipeline"
      ]
    },
    {
      "title": "Risk gates, in order",
      "dot": "rose",
      "items": [
        "Daily loss, open positions, total and per-sport exposure",
        "Fee-aware edge floor, too-good edge, price floor/ceiling, spread and volume",
        "Days to event, composite score, confidence, NO on heavy favorite",
        "Already started, already held, per-event cap, opposite side, recent matchup",
        "Venue eligibility runs last and is skipped under DRY_RUN"
      ]
    },
    {
      "title": "Knobs that change behaviour",
      "dot": "cyan",
      "items": [
        "DRY_RUN: real order vs dry_run_blocked row",
        "MIN_EDGE_THRESHOLD (+ per-sport overrides)",
        "KELLY_FRACTION, KELLY_EDGE_CAP",
        "KALSHI_FEE_RATE, MAX_BET_SIZE, MAX_DAILY_LOSS"
      ]
    }
  ]
