# Edge-Radar Environment Variables
# Copy this file to .env and fill in your values. NEVER commit .env.
#
# ─────────────────────────────────────────────────────────────────────────────
# QUICK START — the 5 things most users ever touch:
#   1. KALSHI_API_KEY + KALSHI_PRIVATE_KEY_PATH   (required, live trading)
#   2. ODDS_API_KEYS                              (required, sports edge detection)
#   3. UNIT_SIZE                                  (default bet size)
#   4. MAX_DAILY_LOSS + MAX_OPEN_POSITIONS        (your safety rails)
#      + MAX_OPEN_EXPOSURE_PCT                    (the only cap on TOTAL money deployed)
#   5. DRY_RUN                                    (keep true until you're ready)
# Everything else has calibrated defaults. See DETAILED DESCRIPTIONS below for
# the "why" behind each knob before tuning.
# ─────────────────────────────────────────────────────────────────────────────


# === 1. API CREDENTIALS (required) ===========================================
KALSHI_API_KEY=
KALSHI_PRIVATE_KEY_PATH=keys/live/kalshi_private.key
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_SUBACCOUNT=0                 # P1: 0 = primary account. 1-63 = an exchange-enforced
                                    # separate wallet under the same login (Advanced API tier),
                                    # scoping every balance/position/order/fill call. This is the
                                    # ONLY thing that isolates a bankroll -- a second API key, or
                                    # a second checkout of this repo, both still draw on one
                                    # balance. Usually set in a profile overlay, not here.
                                    # See .env.longshot.example.
ODDS_API_KEYS=                      # Comma-separated. Free keys: https://the-odds-api.com
# ODDS_API_KEY=                     # Single-key fallback, used only when ODDS_API_KEYS is empty.
# KALSHI_PRIVATE_KEY=               # Inline PEM instead of the path above, for hosts with
                                    # no key file on disk. Local runs should use
                                    # KALSHI_PRIVATE_KEY_PATH.

# --- Optional prod-pointing Kalshi credentials (make_prod_client) ------------
# A second credential set for scripts that must hit production regardless of
# what KALSHI_BASE_URL points at. Leave unset unless you run a split setup.
# KALSHI_PROD_API_KEY=
# KALSHI_PROD_PRIVATE_KEY_PATH=
# KALSHI_PROD_BASE_URL=https://api.elections.kalshi.com/trade-api/v2

# --- Optional integrations ---------------------------------------------------
# Alpaca is used only by scripts/.../fetch_market_data.py (stocks/options data);
# Telegram only by scripts/schedulers/automation/telegram_bot.py. Neither is
# used by the scan/execute path or the dashboard.
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# ALPACA_BASE_URL=https://paper-api.alpaca.markets
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=


# === 2. CORE LIMITS — main safety rails ======================================
UNIT_SIZE=1.00                      # Default bet size (USD). Overridable via --unit-size.
MAX_BET_SIZE=100                    # Hard cap per single bet (USD).
MAX_DAILY_LOSS=250                  # Halt new bets when today's P&L hits -$250.
MAX_OPEN_POSITIONS=50               # Max unsettled positions at once.
MAX_PER_EVENT=2                     # Max bets per single game/event.
MAX_PER_EVENT_FUTURES=2             # P1: same cap, futures only (`category == "futures"`).
                                    # Defaults to MAX_PER_EVENT when unset, so leaving this
                                    # alone changes nothing. Worth raising only if you want a
                                    # diversified multi-outcome futures book: 3 underdogs in one
                                    # championship PARTITION the event rather than doubling down
                                    # on it, which 3 sides of one game would.

# S4 (2026-08-26) Gate 2b: the only gates that measure a STANDING TOTAL rather than
# one order, one event, or one batch. Everything above counts rows or binds a single
# bet -- all of them passed the whole way while 26 NFL positions accumulated to 31%
# of bankroll over three months. Fractions of EQUITY (cash + position value), not of
# cash: every dollar bought subtracts from cash AND adds to exposure, so a cash
# denominator climbs at twice the rate of the risk. Ship at 0 (off) so a fresh clone
# is unchanged. The gate rejects at/over a ceiling and trims an order to the
# remaining headroom. Both are worth setting -- a portfolio cap alone lets one sport
# hold all of it; a segment cap alone lets N sports each hold their share.
MAX_OPEN_EXPOSURE_PCT=0             # Total open at-risk / equity. Try 0.20-0.50.
MAX_SEGMENT_EXPOSURE_PCT=0          # Same, per sport (falls back to category). Try 0.10-0.33.


# === 3. REJECT GATES — quality bar every opportunity must clear ==============
MIN_EDGE_THRESHOLD=0.03             # Min edge (3%). Global; per-sport overrides in section 5.
                                    #   NOTE: since 2026-08-25 the gate adds the exchange fee to
                                    #   this floor, so the effective bar is ~4.8% at 50c, ~3.6% at 10c.
KALSHI_FEE_RATE=0.07                # Exchange taker fee: ceil(rate * C * P * (1-P)), rounded up per
                                    #   order. Folded into the Gate 3 edge floor AND Kelly sizing.
                                    #   Was invisible end to end until 2026-08-25 (3.6% of stake,
                                    #   1.02c/contract, unrecorded). 0 disables fee awareness.
MIN_MARKET_PRICE=0.12               # R7: reject bets priced below this (lottery-ticket floor). 0 disables. Raised 0.06->0.12 2026-07-14 (sub-15c bets went 0W-21L).
MAX_MARKET_PRICE=1.0                 # Gate 3.55: reject bets whose cost/payout ratio exceeds this (76c to win $1 = 76%, rejected). 1.0 disables.
MAX_BID_ASK_SPREAD=0.05             # Gate 3.6: reject books wider than this (dollars on a $0-1 contract). 0 disables.
MIN_MARKET_VOLUME_24H=0             # Gate 3.6 companion: min contracts traded in trailing 24h. 0 disables (default).
MAX_DAYS_TO_EVENT_FOR_GAME_MARKETS=0  # S5 Gate 3.7: max days from now to a GAME's date. 0 disables.
                                    #   FUTURES ARE EXEMPT by category -- a championship's event is a
                                    #   whole season. Caps LEAD TIME, not sports: near-dated college
                                    #   football (3-4 days out) is untouched. All 26 NFL positions that
                                    #   reached 31% of bankroll were bought 25+ days out (median 35,
                                    #   max 112); nothing settled for months, so no feedback arrived
                                    #   while exposure stacked. Try 14.
MIN_COMPOSITE_SCORE=6.0             # Min opportunity score (0-10).
MIN_CONFIDENCE=medium               # low | medium | high. Gate 4.5 (R3).
SERIES_DEDUP_HOURS=48               # Reject same matchup bet within this window. 0 disables.
RESTING_ORDER_MAX_HOURS=24          # R4: cancel zero-fill resting orders older than this. 0 disables.
ALLOW_PREDICTION_BETS=false         # R25 Gate 4.7: reject crypto/weather/spx/mentions/companies/politics bets. Prediction-market models currently surface garbage fair values (see 2026-04-24 audit). Set true to opt back in.
ALLOW_LIVE_BETS=false               # L1 Gate 4.8: reject bets on games already in progress (is_game_started). The L1 freshness fix makes live edges honest; keep in-play opt-in until calibrated. Set true to enable live betting.
CROSS_CATEGORY_DEDUP=false          # R8: when true, collapse ML+Total+Spread on same game to one bet (highest composite). Default false because cross-category correlation varies by sport. Per-sport overrides below.

# NO-side favorite guard (R1, Gate 4.6). Reject NO bets on heavy favorites
# unless edge AND confidence both clear a much higher bar.
NO_SIDE_FAVORITE_THRESHOLD=0.25     # Below this NO-side price, the gate applies.
NO_SIDE_MIN_EDGE=0.25               # Required edge when below threshold (also needs confidence=high).

# R28 (2026-06-23): global NO-side edge floor. The 90-day review found NO bets
# net -7.0% ROI vs YES +48.1% at near-identical win rates. Every NO bet's
# effective edge floor becomes max(per-sport floor, this) regardless of price.
NO_SIDE_MIN_EDGE_GLOBAL=0.08        # Min edge (8%) required on ANY NO bet. 0 disables.


# === 4. SIZING — Kelly with soft-cap and dampeners ===========================
KELLY_FRACTION=0.25                 # Quarter-Kelly. Divided by batch size at runtime -> a PORTFOLIO fraction. Keep <= 0.5.
KELLY_EDGE_CAP=0.15                 # Soft-cap on edge used in Kelly (raw edge unchanged in gates).
KELLY_EDGE_DECAY=0.5                # Decay on edge above the cap. 0.5 = half weight on excess.
MAX_BET_RATIO=3.0                   # Max single bet as multiple of batch median cost.

# NO-side half-Kelly dampener (R1). Complements the reject gate above: NO bets
# that clear gate 4.6 but are still on moderate favorites get downsized.
NO_SIDE_KELLY_PRICE_FLOOR=0.35      # Below this NO-side price, apply multiplier.
NO_SIDE_KELLY_PRICE_CEILING=0.50    # F4 (2026-08-25): mirror of the floor, same multiplier.
                                    #   NO at/above this price is where the side actually
                                    #   bleeds: n=68, $90 staked, -11.3% ROI. R1's floor rule
                                    #   only ever damped the CHEAP end. 0 disables.
                                    #   Damped not blocked -- that population is +4.8% Mar-May
                                    #   vs -16.0% Jun-Aug (MLB/MLS totals), too uneven for a gate.
NO_SIDE_KELLY_MULTIPLIER=0.5        # 0.5 = half-Kelly. Applies at BOTH ends. 1.0 disables.

# R28 (2026-06-23): global NO-side Kelly dampener. Unlike the price-floored
# multiplier above, this applies to EVERY NO bet. Defaults to 1.0 (off) — the
# R28 edge floor does the heavy lifting; turn this down to also shrink NO sizing.
NO_SIDE_KELLY_MULTIPLIER_GLOBAL=1.0 # Multiplier on Kelly for all NO bets. 1.0 = disabled.


# === 5. PER-SPORT EDGE FLOORS (optional overrides) ===========================
# Calibration (2026-04-18) showed NBA (-15% ROI) and NCAAB (-62% ROI) losing at
# the 3% global floor; MLB joined (40% WR, -12% ROI). These ran a peer floor
# (documented at 0.08, production at 0.06) on the theory the model over-claimed
# ~15% edge. 2026-06-14: lowered to 0.04 — the 06-03/06-05 edge-matching fixes
# de-inflated edges at the source, so the higher floor was double-correcting the
# same over-claim and choking off honest 3-6% edges (esp. MLB, the summer slate).
# Running as a 2-4 week experiment; recalibrate on fresh post-fix data and retune.
# NHL stays on the 3% global floor (+100% ROI — do not raise).
# Supported: MLB, NBA, NHL, NFL, NCAAB, NCAAF, MLS, SOCCER, WORLDCUP, UFC,
# BOXING, GOLF, NASCAR, IPL, ESPORTS, TENNIS. (The last eight were orphaned
# until 2026-08-25 -- the name must match ticker_display._detect_sport().)
#
# SWITCHING A SPORT OFF: set its floor to 1.0. Edge is bounded by 1, so the
# floor can never be cleared; the executor reports `sport_disabled` and the scan
# preview shows `off`. No separate kill switch needed.
MIN_EDGE_THRESHOLD_NBA=0.04
MIN_EDGE_THRESHOLD_NCAAB=0.04
MIN_EDGE_THRESHOLD_MLB=0.04
MIN_EDGE_THRESHOLD_WORLDCUP=1.0     # OFF (2026-08-25). 43 settled bets, -43.2% ROI,
                                    #   all YES. Model said 22.9%, Kalshi said 16.3%,
                                    #   reality 13.9% -- the price was near-exact and the
                                    #   model was 9pts high. Re-enable only with a
                                    #   recalibrated soccer margin model.
# MIN_EDGE_THRESHOLD_NHL=0.03
# MIN_EDGE_THRESHOLD_NFL=0.03
# MIN_EDGE_THRESHOLD_NCAAF=0.03
# MIN_EDGE_THRESHOLD_MLS=0.03
# MIN_EDGE_THRESHOLD_SOCCER=0.03

# R29 (2026-06-23): NBA consensus-book floor. The 90-day review flagged NBA at
# -23.3% ROI. NBA games with fewer than this many agreeing books get their
# confidence dropped to `low` (which Gate 4.5 then rejects at MIN_CONFIDENCE),
# filtering edges built on stale recreational lines. 0 disables the check.
MIN_CONSENSUS_BOOKS_NBA=8

# R9 (2026-04-27): per-sport SERIES_DEDUP_HOURS overrides. Global is 48h
# (section 3); MLB and NHL series cycle on consecutive days, so a 48h window
# leaks adjacent-game bets (F12: NYM/LAD bet Apr 14 + Apr 16 = 49h, both lost).
# 72h covers any 3-game series end-to-end. NBA leaves the global default —
# same opponent twice within 48h is rare outside the playoffs. Value 0 on a
# specific sport disables dedup for that sport while keeping the global on.
SERIES_DEDUP_HOURS_MLB=72
SERIES_DEDUP_HOURS_NHL=72
# SERIES_DEDUP_HOURS_NBA=48
# SERIES_DEDUP_HOURS_NCAAB=48
# SERIES_DEDUP_HOURS_NFL=48
# SERIES_DEDUP_HOURS_NCAAF=48
# SERIES_DEDUP_HOURS_MLS=48
# SERIES_DEDUP_HOURS_SOCCER=48

# R8 (2026-04-29): per-sport CROSS_CATEGORY_DEDUP overrides. The current
# (event_key, category) dedup keeps ML + Total + Spread on the same game as 3
# distinct bets. F11 flagged 12 matchups bet >=2x within 14d, several same-day
# on different categories — correlated exposure with no diversification benefit
# in sports where ML / Spread / Total move together (NBA blowouts, NFL routs).
# Per-sport opt-in because cross-category correlation is sport-dependent: NHL
# low-scoring games keep ML and Total weakly correlated, while NBA blowouts
# tighten all three. Setting CROSS_CATEGORY_DEDUP=true above flips it on
# globally; per-sport vars below override the global in either direction.
# CROSS_CATEGORY_DEDUP_NBA=true
# CROSS_CATEGORY_DEDUP_NCAAB=true
# CROSS_CATEGORY_DEDUP_MLB=false
# CROSS_CATEGORY_DEDUP_NHL=false
# CROSS_CATEGORY_DEDUP_NFL=true
# CROSS_CATEGORY_DEDUP_NCAAF=true
# CROSS_CATEGORY_DEDUP_MLS=false
# CROSS_CATEGORY_DEDUP_SOCCER=false


# === 6. SYSTEM ===============================================================
DRY_RUN=true                        # Set false for live execution.
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR.
# PROJECT_ROOT=                     # Override the inferred repo root (backtester report
                                    # dir). Leave unset unless you know you need it.

# Email notifications (optional). Consumed by the report-emailer shell scripts
# documented in docs/task-schedules/README.md, which send through Resend
# (scripts/custom/Python/send_report_email.py). Leave blank if you don't run the
# scheduled email tasks. NOTIFY_EMAIL is the inbox you want reports sent TO;
# RESEND_FROM is the verified-domain address they're sent FROM. Both are
# referenced as <YOUR_EMAIL> / <YOUR_SENDER> in the script templates.
#
# RESEND_API_KEY does NOT belong here — it lives in the OS environment so a
# scheduled task picks up a rotated key on its next launch with no file edit
# (Windows: setx RESEND_API_KEY "re_...", then open a new terminal).
# Migrated off AgentMail 2026-08-19; AGENTMAIL_INBOX / AGENTMAIL_API_KEY are dead.
NOTIFY_EMAIL=                       # e.g. you@example.com — where scheduled reports are emailed.
RESEND_FROM=                        # e.g. Edge-Radar <fleet@send.yourdomain.com> — the from-address.
# RESEND_REPLY_TO=                  # Optional Reply-To; defaults to NOTIFY_EMAIL.

# R24b (2026-04-28): file-backed cache for Odds API responses, lives at
# data/cache/odds/<sport_key>__<markets>.json. Survives across CLI invocations
# so back-to-back scans (scheduler bursts, dashboard re-renders) don't refetch
# the same sport keys. F31 documented one key burning ~175 requests in 5 min;
# this is the structural fix. Set ODDS_CACHE_TTL_SECONDS=0 or
# ODDS_CACHE_ENABLED=false to disable.
ODDS_CACHE_TTL_SECONDS=300          # 5 min default. Tune down if calibration shows staleness bias.
ODDS_CACHE_ENABLED=true
# B7: Odds API regions for --execute runs only; previews always use "us".
# Each extra region costs one more request per call. "us,eu" brings Pinnacle
# (the only sharp book with a weight) into the consensus that places orders.
ODDS_API_REGIONS_EXECUTE=us

# L1 (2026-06-20): live-aware TTL. When a sport response contains an in-play
# event (commence_time < now), both cache layers (in-process + file) expire on
# this shorter TTL instead of the 300s pre-game one, so in-progress games refetch
# current book odds rather than reusing a frozen pre-game snapshot (the F44
# phantom-edge bug). Pre-game responses keep ODDS_CACHE_TTL_SECONDS.
ODDS_LIVE_TTL_SECONDS=45            # Live/in-play TTL (seconds). Trade freshness vs quota.

# L1 Phase 2 (2026-06-23): for in-progress games, Edge-Radar does a targeted
# per-event odds refetch (GET /events/{id}/odds, bypassing the sport cache) and
# drops any bookmaker whose line is older than this from the consensus — so a
# suspended/stale in-play book can't poison the fair value.
MAX_LIVE_BOOK_AGE_SECONDS=1200      # Exclude live books older than this (20 min). 0 disables.
MIN_LIVE_CONSENSUS_BOOKS=3          # L1 Phase 2: when the stale filter thins an in-progress game's consensus below this many fresh books, skip it rather than price off 1-2 quotes. Only fires when staleness actually removed books; pre-game markets unaffected. 0 disables.

# R26 (2026-04-29): file-backed cache of the last preview's row→ticker mapping,
# lives at data/cache/last_scan.json. Locks row order between
# `scan.py … --filter X` (preview) and the follow-up
# `scan.py … --pick 1,3 --execute`. Without it, the second live scan can
# reorder rows on price/score drift and execute the wrong picks (observed
# 2026-04-29). 600s default = enough to read the table and pick rows; pass
# --rescan on the execute call to opt out per-invocation. Set
# SCAN_CACHE_TTL_SECONDS=0 or SCAN_CACHE_ENABLED=false to disable.
SCAN_CACHE_TTL_SECONDS=600          # 10 min default.
SCAN_CACHE_ENABLED=true

# C8 (2026-06-23): auto-recalibrated per-sport CDF stdevs. model_calibration.py
# writes recommended SPORT_MARGIN_STDEV / SPORT_TOTAL_STDEV to
# data/cache/calibration_stdevs.json from settled-trade outcomes; the edge
# detector reads them at runtime, closing the hand-tuning loop (F40). Cached
# values older than the TTL are ignored and the hardcoded defaults are used.
CALIBRATION_STDEVS_TTL_DAYS=30      # Max age of cached stdev recommendations.
TEST_CALIBRATION_STDEVS=false       # Test-only: force-read the cache regardless of TTL.

# 2026-07-31: pre-wager calibration check. The C8 loop silently did nothing for
# its entire life — the weekly task ran on schedule, exited 0, and rewrote the
# cache every week with the hardcoded defaults, because a --days 7 window could
# never reach the 20-sample bar. Every age-based check reported "fresh" while
# the model priced 11 days of MLB totals against a stdev 16% too narrow.
# So the preflight recomputes instead of checking age: it compares the cache to
# what the calibrator would produce from current settled data. A legitimate
# "too few samples" or "gap within noise" recomputes to the same value and stays
# silent; only a loop that is broken or behind the evidence trips it.
# Warning always prints. Set true to make it a hard stop on --execute.
REQUIRE_FRESH_CALIBRATION=false     # true = refuse to execute when calibration is behind.


# ─────────────────────────────────────────────────────────────────────────────
# DETAILED DESCRIPTIONS — the "why" behind each knob
# ─────────────────────────────────────────────────────────────────────────────
# Only the non-obvious ones. Variables with a self-explanatory inline comment
# above are omitted here.

# --- API credentials ---------------------------------------------------------
#
# KALSHI_PRIVATE_KEY_PATH
#   Path to your RSA private key used to sign API requests. Upload the public
#   half to Kalshi Settings > API; keep the private half local.
#
# ODDS_API_KEYS
#   Free tier: 500 req/month per key. The system rotates automatically when a
#   key hits its quota — more keys = more scans per month. Format: key1,key2,key3.

# --- Sizing ------------------------------------------------------------------
#
# UNIT_SIZE
#   Floor below which Kelly cannot shrink. Keeps tiny-edge bets from rounding
#   to $0. Overridable per-run with --unit-size.
#
#   C11 (2026-07-27): this is the LONGSHOT knob. Below ~30c the flat floor
#   round(UNIT_SIZE / price) binds and Kelly never clears it; above ~60c Kelly
#   binds and UNIT_SIZE is irrelevant (at 83c it asks for 1 contract). The two
#   sizing lanes bind at different prices and are tuned independently — reach
#   for UNIT_SIZE to move longshots, KELLY_FRACTION to move favorites.
#
#   NOTE: the scheduler .bat files pass --unit-size explicitly, and CLI flags
#   beat .env. Changing this here affects manual runs only — grep
#   scripts/schedulers/ and update those too.
#
# KELLY_FRACTION
#   Fraction of full Kelly. Quarter-Kelly (0.25) is the industry standard for
#   a smoother equity curve. At runtime, further divided by batch size to avoid
#   over-leveraging when many bets fire at once.
#
#   That /batch_size divisor doubles as a crude correlation guard — a slate
#   whose legs share an underlying splits ONE Kelly allocation rather than
#   stacking N — which makes this effectively a *portfolio* Kelly fraction, not
#   a per-bet one. At 1.0 a fully correlated slate reaches FULL Kelly. Keep it
#   at or below 0.5.
#
#   Sizing itself is f* = edge / (1 - price) (C11, 2026-07-27). The (1 - price)
#   divisor was missing before then, which under-sized favorites by up to ~6x
#   at 83c and pinned nearly every bet above 60c to the UNIT_SIZE floor.
#
# MAX_BET_RATIO
#   Prevents one high-edge, low-price bet from dominating a batch. 3.0 means
#   no single bet can cost more than 3× the median bet in the same run. Only
#   scales down outliers — other bets stay unchanged.
#
# KELLY_EDGE_CAP / KELLY_EDGE_DECAY
#   Soft-cap applied ONLY inside the Kelly calculation. Raw edge still drives
#   gate 3, composite score, reports, and trade rationale.
#       trusted = edge                            if edge <= cap
#       trusted = cap + (edge - cap) * decay      if edge >  cap
#   Rationale: post-baseline calibration (2026-04-18) showed claimed edges
#   >=25% realize -35% ROI while 10-15% edges realize +127%. Big claimed edges
#   are systematically overstated; this downsizes likely fakes without
#   eliminating them. Defaults: a claimed 25% edge sizes like 20%; 35% like 25%.

# --- Reject gates ------------------------------------------------------------
#
# MIN_EDGE_THRESHOLD
#   Edge = (estimated probability) - (implied probability from Kalshi price).
#   Global default when no per-sport override is set. Higher = fewer but
#   higher-quality bets.
#
# MIN_MARKET_PRICE
#   Gate 3.5 (R7, 2026-04-22). Hard floor on market price — reject any bet
#   priced below this, regardless of edge or confidence. F10 from the
#   14-day review: sub-10¢ bets went 1W-3L while the model claimed "+50%
#   edge" on 8-10¢ longshots. Raised 0.06→0.12 on 2026-07-14 after a 30-day
#   review found every sub-15¢ bet lost (0W-21L, -100% ROI, mostly World Cup
#   spread YES longshots) while ≥25¢ bets were profitable. Set to 0 to disable.
#
# MAX_MARKET_PRICE
#   Gate 3.55 (2026-09-03). Hard ceiling on cost/payout ratio — a contract
#   pays $1 if it wins, so market price IS that ratio. Reject any bet priced
#   above this regardless of edge or confidence: a 76¢ bet to win $1 (76%) is
#   rejected, 75¢ (75%) passes. Operator preference; no settled evidence yet
#   (companion to MIN_MARKET_PRICE's floor). Set to 1.0 to disable.
#
# MAX_BID_ASK_SPREAD / MIN_MARKET_VOLUME_24H
#   Gate 3.6 (2026-08-18). Hard liquidity floor. CLAUDE.md has listed "the
#   market is clearly illiquid (spread > 5%)" as a Hard Stop since launch and
#   MLB_FILTERING_GUIDE.md repeats it as a graduated rule, but until now
#   neither was enforced: spread reached scoring only as the soft `liquidity`
#   composite term (max(0, 10 - spread*20), 20% weight), so a 20¢-wide book
#   still scored 6.0/10 there and cleared MIN_COMPOSITE_SCORE on the strength
#   of a large tail edge. The 2026-08-18 NFL Week 1 audit found 13 of 27 open
#   positions past the documented line (up to 20¢ wide) and 18 of 27 with zero
#   24h volume — an "edge" measured against an ask nobody trades at, with no
#   bid to exit into before settlement.
#   MAX_BID_ASK_SPREAD is absolute dollars on a $0-1 contract, matching both
#   the documented "5%" and the existing liquidity term's units. The volume
#   floor catches books with a tolerable spread that simply never trade; it
#   ships at 0 (off) since spread is the documented rule. Either at 0 disables
#   that half. An opportunity carrying no recorded spread is NOT rejected —
#   unknown is not evidence of illiquidity.
#
# MIN_COMPOSITE_SCORE
#   Weighted score combining edge, confidence, liquidity, data-source
#   agreement, line movement, and team stats. Opportunities below this are
#   skipped regardless of edge.
#
# MIN_CONFIDENCE
#   Gate 4.5 (R3, 2026-04-21). Rejects any opportunity whose confidence ranks
#   below this floor. Two review windows (2026-04-18, 2026-04-21) showed low
#   confidence at 0W-3L / -105% ROI. Set to "low" to disable; "high" for the
#   strictest filter.
#
# NO_SIDE_FAVORITE_THRESHOLD / NO_SIDE_MIN_EDGE
#   Gate 4.6 (R1, 2026-04-21). NO bets on heavy favorites need edge >=
#   NO_SIDE_MIN_EDGE AND confidence=high. Rationale: every high-edge loser
#   (13 of 13) in the 14-day window was a NO bet on a heavy favorite; NO at
#   >=20% edge realized 31% WR / -33% ROI. Set NO_SIDE_FAVORITE_THRESHOLD=0
#   to disable the gate entirely.
#
# NO_SIDE_KELLY_PRICE_FLOOR / NO_SIDE_KELLY_MULTIPLIER
#   Sizing dampener (R1). NO bets priced below the floor are sized at
#   MULTIPLIER of normal Kelly (default half-Kelly below 35¢). Catches bets
#   that clear gate 4.6 but still lean into the overstated-edge pattern. Set
#   NO_SIDE_KELLY_MULTIPLIER=1.0 to disable.
#
# SERIES_DEDUP_HOURS
#   Gate 7 (C5, 2026-04-18). Reject a new bet if the same matchup (sport +
#   team pair, date-agnostic) was already bet within this many hours. Catches
#   series-level correlation the within-batch dedup can't see. Reads the
#   local trade log, so dry-run runs don't count. Default 48h covers typical
#   3-game MLB/NHL series; raise to 72h for weekly events.
#
# RESTING_ORDER_MAX_HOURS
#   Resting-order janitor (R4, 2026-04-21). At the top of every live execute
#   run, any resting order older than this with zero fills is auto-cancelled.
#   The 14-day review showed 16% of new orders (4/25) rested 25-66h with zero
#   fills — tying up balance without contributing to P&L. Partial/full fills
#   are left alone (the settler handles them). 0 disables. Runs only when
#   execute=True AND DRY_RUN=false; preview scans never touch the order book.

# --- System ------------------------------------------------------------------
#
# DRY_RUN
#   When true, the system scans, sizes, and logs what it WOULD have done
#   without placing real orders. Set to false only when ready to bet real money.

# ── Exchange sharding (2026-08-27) ───────────────────────────────────────────
# Kalshi sharded the exchange on 2026-08-24: Crypto -> shard 2, Tennis &
# Baseball -> shard 3, everything else stays on shard 0. Cash does NOT follow
# the markets — an order on a shard holding no funds fails `404 user_not_found`.
# Sizing is deliberately whole-account (bankroll = balance summed across every
# shard), so an order can be correctly sized and still unspendable where it
# lands. With this on, the executor moves exactly the shortfall from
# SHARD_FUNDING_SOURCE immediately before placing; with it off, the order is
# skipped and logged as `shard_underfunded`.
AUTO_SHARD_TRANSFER=false           # ships OFF: never move money unattended on a fresh clone
SHARD_FUNDING_SOURCE=0              # shard 0 "Default" holds the reserve
MAX_AUTO_SHARD_TRANSFER=25.00       # ceiling on ONE automatic move (USD)
