# Diagram files are hashed byte-for-byte by their build receipts; never convert line endings.
docs/diagrams/betting-data-flow.* -text
site/diagram/* -text

# Cronsole verifies registry files by sha256 over exact bytes.
site/registry/** text eol=lf

# Batch files run under cmd.exe, which mishandles labels and long lines in LF-only files.
*.bat text eol=crlf
